---
import Mail from "../icons/Mail.astro";
import WhatsApp from "../icons/Whatsapp.astro";
---

<div
  class="p-8 text-center border-t-6 border-t-yellow-100 rounded-lg shadow-sm bg-gray-800 mb-10"
>
  <h5 class="mb-2 text-3xl font-bold text-white">Pongámonos en contacto</h5>
  <p class="mb-5 text-base sm:text-lg text-gray-200 text-pretty sm:text-md">
    Estoy siempre abierto a discutir nuevas oportunidades y proyectos. No dudes
    en ponerte en contacto ¡Me encantaría saber de ti!
  </p>

  <form
    id="contact-form"
    action="https://formspree.io/f/xzzqgezd"
    method="POST"
    class="max-w-3xl mx-auto mt-10 text-left"
  >
    <div class="mb-4">
      <label for="name" class="block mb-2 text-sm font-medium text-white"
        >Tu Nombre</label
      >
      <input
        type="text"
        id="name"
        name="name"
        required
        class="bg-gray-700 border border-gray-600 text-white text-sm rounded-lg focus:ring-yellow-100 focus:border-yellow-100 block w-full p-2.5 placeholder-gray-400"
        placeholder="Tu nombre completo"
      />
    </div>

    <div class="mb-4">
      <label for="email" class="block mb-2 text-sm font-medium text-white"
        >Tu Email</label
      >
      <input
        type="email"
        id="email"
        name="_replyto"
        required
        class="bg-gray-700 border border-gray-600 text-white text-sm rounded-lg focus:ring-yellow-100 focus:border-yellow-100 block w-full p-2.5 placeholder-gray-400"
        placeholder="ejemplo@correo.com"
      />
    </div>

    <div class="mb-6">
      <label for="message" class="block mb-2 text-sm font-medium text-white"
        >Tu Mensaje</label
      >
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        class="block p-2.5 w-full text-sm rounded-lg border bg-gray-700 border-gray-600 placeholder-gray-400 text-white focus:ring-yellow-100 focus:border-yellow-100"
        placeholder="Escribe tu mensaje aquí..."></textarea>
    </div>

    <button
      type="submit"
      class="w-full sm:w-auto px-5 py-3 text-base font-medium text-center inline-flex items-center justify-center text-gray-800 bg-yellow-100 rounded-lg hover:bg-yellow-200 transition-colors duration-200"
    >
      <Mail class="me-2" />
      Enviar Mensaje
    </button>
  </form>

  <div class="items-center justify-center mt-10 gap-3 sm:flex">
    <a
      target="_blank"
      rel="noopener"
      href="mailto:benjaminlopezzigaran01@gmail.com"
      class="px-5 py-3 text-base font-medium text-center inline-flex items-center text-white hover:text-gray-100 bg-transparent rounded-lg border border-yellow-100 hover:scale-[1.02] transition-transform duration-200"
    >
      <Mail class="me-2" />
      Enviame un correo
    </a>
    <a
      rel="noopener"
      href="https://wa.me/543814565765"
      target="_blank"
      class="px-5 py-3 mt-3 md:mt-0 text-base font-medium text-center inline-flex items-center text-white hover:text-gray-100 bg-transparent rounded-lg border border-yellow-100 hover:scale-[1.02] transition-transform duration-200"
    >
      <WhatsApp class="me-2" />
      WhatsApp
    </a>
  </div>
</div>
<script>
  import "../scripts/handleForm.js";
</script>
